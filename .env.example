###############################################################################
# Clinic Platform - environment template
#
# Copy this file to `.env` at the workspace root and fill it in:
#
#     cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# `.env` is git-ignored. Never commit real credentials.
#
# ---------------------------------------------------------------------------
# THE ONE RULE THAT MATTERS
# ---------------------------------------------------------------------------
# There are two classes of variable in this file, and they must never mix:
#
#   SERVER-ONLY   Read by the NestJS API process only. These are secrets.
#                 They are never bundled, never sent to a browser, never
#                 prefixed with VITE_.
#
#   PUBLIC        Prefixed with VITE_. Vite inlines these into the JavaScript
#                 it ships to browsers and to the Capacitor web view. Anything
#                 here is effectively public - assume a user can read it.
#
# `libs/client/config` refuses to build a config if a VITE_ variable holds a
# value that *looks* like a secret - an `sb_secret_...` key or a postgres://
# connection string - whatever the variable is called. That guard is a
# backstop, not the plan. The plan is not writing one here.
#
# ---------------------------------------------------------------------------
# SUPABASE KEY MODEL
# ---------------------------------------------------------------------------
# This project uses Supabase's current API key model:
#
#   sb_secret_...        server-only, bypasses Row Level Security
#   sb_publishable_...   safe in a browser, constrained by RLS
#
# The legacy `anon` and `service_role` JWT keys are NOT used. If
# SUPABASE_SERVICE_ROLE_KEY is set, the API refuses to start and tells you to
# rename it - a stale deployment should fail loudly, not look healthy.
###############################################################################


###############################################################################
# SERVER-ONLY - NestJS API (apps/api). Secrets.
###############################################################################

# Port the API listens on. Defaults to 3000.
API_PORT=3000

# Comma-separated list of browser origins allowed to call the API.
# Use `*` for local development only; set explicit origins in production.
# Local defaults: mobile on 4200, dashboard on 4201.
API_CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# development | test | production
NODE_ENV=development


# --- Supabase APIs: Auth, Storage, Realtime later -------------------------
#
# NOT used for business data - see the DATABASE_URL section below.

# Supabase project URL.
# Local (`supabase start`):  http://127.0.0.1:54321
# Hosted:                    https://<project-ref>.supabase.co
SUPABASE_URL=

# SECRET. The `sb_secret_...` key. Bypasses Row Level Security.
# Server-side only - never give this a VITE_ prefix.
# Supabase dashboard -> Project Settings -> API Keys -> Secret keys.
SUPABASE_SECRET_KEY=

# Optional. The `sb_publishable_...` key, so the API can build user-scoped
# Supabase clients (SupabaseService.forUser) for Storage and Realtime that
# respect RLS. Same value as VITE_SUPABASE_PUBLISHABLE_KEY - not a secret.
SUPABASE_PUBLISHABLE_KEY=

# SECRET. Keys the HMAC that protects guardian claim codes.
# A claim code is six digits - a million possibilities - so a plain digest
# would fall to an offline search the moment the table leaked. This keeps the
# key out of the database entirely. Minimum 32 characters.
# Generate one with: openssl rand -base64 48
# Server-side only - never give this a VITE_ prefix.
CLAIM_CODE_PEPPER=

# The clinic this deployment serves, matching clinic.clinics.slug.
# Not a secret. The schema is multi-tenant; this says which tenant this API
# is for, so a parent who has not onboarded yet knows which clinic they are
# joining. Pilot value: shimaa-talal
CLINIC_SLUG=


# --- PostgreSQL: transactional business data ------------------------------
#
# Separate from the Supabase variables on purpose. supabase-js speaks PostgREST
# over HTTP, where every call is its own implicit transaction, so it cannot run
# a multi-statement unit of work. Domain services use a direct PostgreSQL
# connection instead. See docs/database.md.

# SECRET - contains a database password.
# Local (`supabase start`):
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: Supabase dashboard -> Project Settings -> Database -> Connection
#   string. Prefer the *session* pooler for a long-lived Node pool - the
#   transaction pooler does not preserve session state and breaks BEGIN/COMMIT.
# Connects as `clinic_api`, never as the owner. See docs/database.md.
DATABASE_URL=

# Migrations only - NOT read by the API.
#
# DATABASE_URL above connects as `clinic_api`, a least-privilege role with
# explicit per-table grants and no CREATE, so it deliberately cannot apply a
# migration. Schema changes run as the owner with this connection string
# instead, which keeps the running application unable to alter its own schema.
# SECRET - contains a database password.
MIGRATION_DATABASE_URL=

# Maximum pooled connections held by this API process. Keep the total across
# all processes below the database's connection limit.
#
# Supabase's session-mode pooler allows 15 clients. A running `nx serve api`
# holds up to this many on its own, and a test run holds its own pool plus the
# one its application creates — so running the database-backed suites while the
# dev server is up can exhaust the pooler and fail tests that are not wrong.
# Stop the dev API before a full test run, or lower this.
DATABASE_POOL_MAX=10

# Milliseconds to wait for a free connection before failing the request.
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Server-side cap on a single statement, so a runaway query cannot hold a
# pooled connection open indefinitely.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# TLS for the database connection. Required by hosted Supabase; a local
# container does not offer it. Defaults to true only when NODE_ENV=production.
DATABASE_SSL=false


###############################################################################
# PUBLIC - Vue frontends (apps/mobile, apps/dashboard).
#
# Everything below is compiled into the browser bundle. Treat as public.
# There is deliberately no database variable here: frontends never connect to
# PostgreSQL. They call the API.
###############################################################################

# Base URL of the NestJS API, including the version segment.
# Defaults to http://localhost:3000/api/v1 when unset.
VITE_API_URL=http://localhost:3000/api/v1

# Supabase project URL. Same value as SUPABASE_URL - it is not a secret.
VITE_SUPABASE_URL=

# The `sb_publishable_...` key. Safe in a client bundle: it is constrained by
# Row Level Security. This is the ONLY Supabase key a frontend may ever hold.
VITE_SUPABASE_PUBLISHABLE_KEY=

# development | staging | production
VITE_APP_ENV=development
