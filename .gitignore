# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Nx
.nx/cache
.nx/workspace-data
.nx/polygraph
.nx/self-healing
.nx/migrate-runs
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Environment files — NEVER commit real secrets.
# Only `.env.example` is tracked.
.env
.env.*
!.env.example

# Capacitor / native
apps/mobile/android
apps/mobile/ios
apps/mobile/www

# Supabase local runtime state
supabase/.branches
supabase/.temp

# Agent skills.
# `.agents/skills/` and `skills-lock.json` ARE committed - they are the shared,
# reproducible source of truth (`npx skills experimental_install` restores them).
# The per-agent directories below are just symlinks/junctions generated by the
# `skills` CLI; on Windows git follows junctions and would commit a second
# duplicate copy of every file.
.claude/skills
.cursor/skills
.gemini/skills
.github/skills
.codex/skills
.opencode/skills

# Personal, machine-local Claude Code settings
.claude/settings.local.json
.claude/worktrees

vite.config.*.timestamp*
vitest.config.*.timestamp*
# Design reference exported from the prototype: ~33 MB of HTML with base64
# fonts embedded in every file, and every computed CSS property inlined on
# every element. It is read while building a screen and never imported, so it
# stays out of the history rather than bloating every clone.
UI/
